---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import LinkList from '../components/LinkList.astro';
import { config } from '../config';
import { getReceptionAILink } from '../lib/links';
import { aboutSchema } from '../lib/schema';

const receptionai = getReceptionAILink();
---

<BaseLayout title="About" description={config.shortBio} jsonLd={aboutSchema()}>
  <div class="about">
    <aside class="about-side reveal" aria-label="Quick facts">
      <Avatar class="avatar-about" size={400} loading="eager" />
      <p class="about-location">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="8.5"></circle><path d="M3.5 12h17M12 3.5c2.4 2.4 3.5 5.2 3.5 8.5s-1.1 6.1-3.5 8.5M12 3.5C9.6 5.9 8.5 8.7 8.5 12s1.1 6.1 3.5 8.5"></path></svg
        >
        {config.location}
      </p>
      <ul class="tag-list" aria-label="About me">
        <li>Engineering student</li>
        <li>Solo founder</li>
        <li>Building ReceptionAI</li>
      </ul>
    </aside>

    <div class="about-main">
      <header class="about-head reveal" style="--delay: 80ms">
        <h1>{config.author}</h1>
        <p class="about-role">Engineering student and solo founder</p>
        <LinkList label="Links" />
      </header>

      <article class="about-story prose reveal" style="--delay: 180ms">
        <p>
          I'm {config.author}, an engineering student and solo founder based in {config.location}.
        </p>

        <p>
          I'm building ReceptionAI, a WhatsApp assistant that answers patient messages and books
          appointments for small private clinics.
        </p>

        <p>
          I don't think you can build something useful for clinics from a desk, so I go to them. I
          visit clinics in person to learn how they handle bookings today: who picks up the phone, how
          patients get in touch, and what happens when the front desk is busy.
        </p>

        <p>
          This blog is where I write down what I learn from those visits. It is early days. I don't
          have customers or results to report, and I won't pretend otherwise. What you will find here
          are plain, honest notes from someone learning as I go.
        </p>

        <h2>What I am working on</h2>

        <p>
          ReceptionAI answers patient messages on WhatsApp and books appointments for small private
          clinics, so the front desk doesn't have to reply to every message by hand.
          {
            receptionai && (
              <>
                {' '}You can read more at <a href={receptionai.href}>{receptionai.display}</a>.
              </>
            )
          }
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
