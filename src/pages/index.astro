---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import PostList from '../components/PostList.astro';
import EmptyPosts from '../components/EmptyPosts.astro';
import LinkList from '../components/LinkList.astro';
import { config } from '../config';
import { getPosts } from '../lib/posts';
import { getLinks, getReceptionAILink } from '../lib/links';
import { categoryHref } from '../lib/categories';

const posts = await getPosts();
const latest = posts.slice(0, 2);
const receptionai = getReceptionAILink();
const hasLinks = getLinks().length > 0;

// Opens /blog with the "Clinic diaries" filter selected.
const diaryHref = categoryHref('clinic-diaries');
---

<BaseLayout title={config.siteName} description={config.tagline}>
  <section class="hero" aria-labelledby="hero-heading">
    {
      receptionai && (
        <a class="hero-badge reveal" href={receptionai.href} rel="noopener">
          <span class="hero-badge-dot" aria-hidden="true" />
          Building ReceptionAI
          <span aria-hidden="true">→</span>
        </a>
      )
    }
    <h1 id="hero-heading" class="hero-title reveal" style="--delay: 80ms">
      {config.tagline}
    </h1>
    <p class="hero-sub reveal" style="--delay: 180ms">
      I'm {config.author}, an engineering student and solo founder in {config.location}.
    </p>
    <div class="hero-actions reveal" style="--delay: 280ms">
      <a class="btn btn-secondary btn-avatar" href="/about">
        <Avatar class="avatar-xs" size={64} loading="eager" alt="" />
        About {config.author}
        <span aria-hidden="true">→</span>
      </a>
      <a class="btn btn-primary" href="/blog">Read the blog</a>
    </div>
  </section>

  <section class="section feature-grid reveal" style="--delay: 380ms" aria-label="What I do">
    <div class="card feature-card">
      <p class="eyebrow">Now</p>
      <h2>What I'm building</h2>
      <p>
        ReceptionAI is a WhatsApp assistant for small private clinics. It answers patient messages
        and books appointments, so the front desk doesn't have to reply to every message by hand.
      </p>
      {
        receptionai && (
          <a class="btn btn-secondary" href={receptionai.href} rel="noopener">
            Visit {receptionai.display}
          </a>
        )
      }
    </div>

    <div class="strip">
      <p class="eyebrow">Field notes</p>
      <h2>Clinic visit diaries</h2>
      <p>{config.intro}</p>
      <a class="btn btn-primary" href={diaryHref}>Read the diaries</a>
    </div>
  </section>

  <section class="section latest" aria-labelledby="latest-heading">
    <div class="latest-rule" aria-hidden="true"></div>
    <div class="latest-inner">
      <div class="latest-head">
        <h2 id="latest-heading">Latest from the blog</h2>
        {latest.length > 0 && <a class="read-link" href="/blog">All posts →</a>}
      </div>
      <div class="latest-posts">
        {latest.length > 0 ? <PostList posts={latest} /> : <EmptyPosts />}
      </div>
    </div>
    <div class="latest-rule latest-rule-end" aria-hidden="true"></div>
  </section>

  {
    hasLinks && (
      <section class="section links-section" aria-label="Links">
        <LinkList label="Links" />
      </section>
    )
  }
</BaseLayout>
