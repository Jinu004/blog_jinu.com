---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

export interface Props {
  posts: Post[];
  /** Heading level for post titles inside the list. */
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel = 'h3' } = Astro.props;
---

<ul class="card-grid">
  {
    posts.map((post) => (
      <li>
        <PostCard post={post} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>
