---
import { config } from '../config';
import { getFaviconPng, publicFile } from '../lib/photo';

export interface Props {
  title: string;
  description: string;
  image?: string;
  /** Alt text for the sharing image (defaults to the default image's alt). */
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image = config.ogImage,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL(config.siteUrl);

// Normalise the path so it matches the public URL (no ".html", no trailing slash).
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '/')
    .replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
// The default sharing image has a known size; a post cover may not.
const isDefaultImage = image === config.ogImage;
const imageAltText = imageAlt ?? (isDefaultImage ? config.ogImageAlt : undefined);
// "About" -> "About | Jinu Joy"; a title that already starts with the name is left as is.
const fullTitle = title.startsWith(config.siteName) ? title : `${title} | ${config.siteName}`;
// Share previews: posts use the post title, other pages the full title.
const shareTitle = type === 'article' ? title : fullTitle;

// Escape "<" so the JSON can never close the script tag early.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';

// Tab icon: public/favicon.png when it exists at build time, otherwise favicon.svg.
const faviconPng = getFaviconPng();
// favicon.ico is what Google and older tools look for first.
const faviconIco = publicFile('/favicon.ico');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#ffffff" />
<meta name="author" content={config.author} />
<meta name="generator" content={Astro.generator} />

{
  faviconPng ? (
    <>
      {faviconIco && <link rel="icon" href={faviconIco} sizes="48x48" />}
      <link rel="icon" type="image/png" href={faviconPng} sizes="192x192" />
      <link rel="apple-touch-icon" href={faviconPng} />
    </>
  ) : (
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  )
}
<link rel="alternate" type="application/rss+xml" title={config.siteName} href={new URL('rss.xml', site).href} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={config.siteName} />
<meta property="og:locale" content={config.ogLocale} />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{
  isDefaultImage && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}
{imageAltText && <meta property="og:image:alt" content={imageAltText} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={shareTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{imageAltText && <meta name="twitter:image:alt" content={imageAltText} />}

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
