---
import { config } from '../config';
import { getInitials, getPhoto } from '../lib/photo';

// Small round logo: the photo when it exists in public/, otherwise the "JJ" monogram.
const photo = getPhoto();

// Simple line icons (24x24, drawn with the current text colour).
const icons = {
  home: '<path d="M4 11.5 12 5l8 6.5"/><path d="M6 10v9h12v-9"/>',
  blog: '<path d="M5 4.5h9.5L19 9v10.5H5z"/><path d="M14.5 4.5V9H19"/><path d="M8.5 13h7M8.5 16h5"/>',
  about: '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 19.5c1.2-3.3 3.8-5 7-5s5.8 1.7 7 5"/>',
  contact: '<rect x="4" y="6" width="16" height="12" rx="2"/><path d="m4.5 7 7.5 6 7.5-6"/>',
};

const nav = [
  { href: '/', label: 'Home', icon: icons.home },
  { href: '/blog', label: 'Blog', icon: icons.blog },
  { href: '/about', label: 'About', icon: icons.about },
  { href: '/contact', label: 'Contact', icon: icons.contact },
];

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/'
    ? current === '/'
    : current === href ||
      current.startsWith(`${href}/`) ||
      (href === '/blog' && current.startsWith('/tags/'));
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-name" href="/">
      {
        photo ? (
          <span class="site-name-mark site-name-mark-photo" aria-hidden="true">
            <img src={photo} alt="" width="32" height="32" decoding="async" />
          </span>
        ) : (
          <span class="site-name-mark" aria-hidden="true">{getInitials()}</span>
        )
      }
      {config.siteName}
    </a>

    <nav class="nav-pill" aria-label="Main">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <svg
                  class="nav-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={item.icon}
                />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="header-meta">
      <span>{config.location}</span>
      <span class="header-time" data-tz="Asia/Kolkata" hidden></span>
    </p>
  </div>
</header>

<script>
  // Local time in Kochi next to the location (desktop only, via CSS). Purely decorative.
  const el = document.querySelector<HTMLElement>('.header-time');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: el.dataset.tz,
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => {
      el.textContent = `${fmt.format(new Date())} IST`;
    };
    tick();
    el.hidden = false;
    setInterval(tick, 30_000);
  }
</script>
